#pragma code_page(65001)
#include <windows.h>

1 RT_MANIFEST "pulsebar.manifest"
102 ICON "pulsebar.ico"

1 VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "PulseBar"
            VALUE "FileVersion", "0.3.0"
            VALUE "ProductName", "PulseBar"
            VALUE "OriginalFilename", "PulseBar.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

103 DIALOGEX 0, 0, 254, 135
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_TOPMOST
CAPTION "PulseBar · 编辑"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "按住状态栏，可拖到任意屏幕上的位置。", -1, 11, 10, 232, 13
    LTEXT "关闭编辑窗口后会保存并置顶，鼠标穿透。", -1, 11, 24, 232, 13
    AUTOCHECKBOX "自动采集 FPS", 201, 11, 46, 103, 14
    AUTOCHECKBOX "读取 CPU 温度", 202, 126, 46, 116, 14
    PUSHBUTTON "更换 DeepSeek Key…", 203, 11, 67, 111, 17
    PUSHBUTTON "选择 PresentMon…", 204, 130, 67, 111, 17
    PUSHBUTTON "更多设置…", 205, 11, 91, 65, 16
    PUSHBUTTON "恢复任务栏停靠", 206, 79, 91, 86, 16
    PUSHBUTTON "FPS 权限说明", 207, 168, 91, 73, 16
    DEFPUSHBUTTON "保存并锁定", IDOK, 169, 113, 72, 16
END

101 DIALOGEX 0, 0, 230, 76
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DeepSeek API Key"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "请输入 DeepSeek API 平台手动创建的完整 Key。", -1, 10, 10, 210, 12
    EDITTEXT 100, 10, 26, 210, 14, ES_AUTOHSCROLL | ES_PASSWORD
    DEFPUSHBUTTON "保存", IDOK, 111, 52, 52, 14
    PUSHBUTTON "取消", IDCANCEL, 168, 52, 52, 14
END
